{
  "name": "bankpilot",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "wecom:dev": "node workers/wecom.mjs",
    "qq:dev": "node workers/qq.mjs",
    "scheduler:dev": "node --env-file=.env.local workers/scheduler.mjs",
    "lint": "eslint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "eval:prompts": "node scripts/run-prompt-eval.mjs",
    "record:daily-review": "node scripts/record-daily-review.mjs",
    "db:up": "docker-compose up -d --wait postgres",
    "db:migrate": "bash scripts/migrate.sh",
    "db:verify": "docker-compose exec -T postgres psql -U bankpilot -d bankpilot < db/invariants.sql",
    "db:setup": "npm run db:up && npm run db:migrate",
    "db:down": "docker-compose down"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@langchain/core": "^1.2.9",
    "@langchain/deepseek": "^1.1.17",
    "@langchain/langgraph": "^1.4.13",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.5",
    "@langchain/openai": "^1.6.2",
    "@tencent-connect/qqbot-nodejs": "^1.0.4",
    "@wecom/aibot-node-sdk": "^1.0.7",
    "cn": "^0.5.0",
    "deepagents": "^1.14.2",
    "langchain": "^1.5.16",
    "lucide-react": "^1.38.0",
    "next": "16.3.8",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
